# ============================================================================
# STAGE 1: build PHP extensions (unchanged from before, discarded after)
# ============================================================================
FROM wordpress:php8.3-apache AS build

RUN apt-get update && apt-get install -y \
    libzip-dev \
    zlib1g-dev \
    libzstd-dev \
    libzstd1 \
    zstd \
    git \
    autoconf \
    make \
    && rm -rf /var/lib/apt/lists/*

RUN pecl install igbinary zstd \
    && docker-php-ext-enable igbinary zstd

RUN git clone --depth=1 https://github.com/phpredis/phpredis.git /tmp/phpredis \
    && cd /tmp/phpredis \
    && phpize \
    && ./configure --enable-redis-zstd --enable-redis-igbinary \
    && make -j$(nproc) \
    && make install \
    && docker-php-ext-enable redis \
    && rm -rf /tmp/phpredis


# ============================================================================
# STAGE 2: final runtime image
# ============================================================================
FROM wordpress:php8.3-apache

COPY --from=build /usr/local/etc/php /usr/local/etc/php
COPY --from=build /usr/local/lib/php /usr/local/lib/php

# Create UID/GID 1300 to match k3s's runAsUser/fsGroup: 1300.
# --shell=/sbin/nologin: service account only, never an interactive login.
RUN groupadd -g 1300 wpuser \
    && useradd -u 1300 -g 1300 --home-dir=/nonexistent --shell=/sbin/nologin wpuser

# Lay down WordPress core into the webroot.
RUN cp -rp /usr/src/wordpress/. /var/www/html/

# --- Immutable core ---
# Own everything under webroot as root, dirs 755 / files 644. Any non-root
# UID (including 1300) can read/execute but cannot write, rename, or delete.
# This is the actual immutability mechanism — it's a filesystem permission,
# not the USER directive.
RUN chown -R root:root /var/www/html \
    && find /var/www/html -type d -exec chmod 755 {} \; \
    && find /var/www/html -type f -exec chmod 644 {} \;

# --- wp-content is intentionally NOT chowned/chmodded here ---
# Your k3s manifest mounts a PVC directly over /var/www/html/wp-content:
#   volumeMounts:
#   - mountPath: /var/www/html/wp-content
#     name: wordpress-data
# That PVC mount completely replaces this directory's contents at container
# start — whatever ownership/permissions we set on it in the image are
# irrelevant, since the NFS share (already owned by 1300 on the QNAP side)
# is what actually gets mounted there. Setting permissions on it here would
# be dead code that only matters in the hypothetical case someone runs this
# image without the PVC mounted (e.g. local `docker run` testing) — if you
# want that fallback case to also be writable by 1300, uncomment:
#
# RUN mkdir -p /var/www/html/wp-content \
#     && chown -R 1300:1300 /var/www/html/wp-content \
#     && find /var/www/html/wp-content -type d -exec chmod 775 {} \; \
#     && find /var/www/html/wp-content -type f -exec chmod 664 {} \;

# Run as the same UID your k3s manifest enforces via runAsUser: 1300.
# This also matters for local `docker run` testing so behavior matches
# what the cluster will actually do.
USER 1300

HEALTHCHECK CMD curl --fail http://localhost || exit 1

ENTRYPOINT ["docker-php-entrypoint"]
CMD ["apache2-foreground"]
